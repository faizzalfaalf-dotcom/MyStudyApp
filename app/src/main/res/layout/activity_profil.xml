<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warna_latar"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/judul_profil"
            android:textColor="@color/warna_teks_utama"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sub_profil"
            android:textColor="@color/warna_teks_sekunder"
            android:textSize="13sp" />

        <!-- Pratinjau Avatar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_kartu"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvPreviewAvatar"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:text="🎓"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_pilih_avatar"
                android:textColor="@color/warna_teks_utama"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbAvatar1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="🎓"
                    android:textSize="20sp" />

                <RadioButton
                    android:id="@+id/rbAvatar2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="💻"
                    android:textSize="20sp" />

                <RadioButton
                    android:id="@+id/rbAvatar3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="🚀"
                    android:textSize="20sp" />

                <RadioButton
                    android:id="@+id/rbAvatar4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐱"
                    android:textSize="20sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Input Nama Mahasiswa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_nama_mahasiswa"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNamaMahasiswa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_nama_mahasiswa"
                android:inputType="textPersonName"
                android:textColor="@color/warna_teks_utama"
                android:textColorHint="@color/warna_teks_sekunder" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSimpanProfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/btn_simpan_profil" />

    </LinearLayout>
</ScrollView>
